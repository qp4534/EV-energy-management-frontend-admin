# 'false'로 설정하면 목업 대신 EXPO_PUBLIC_API_URL로 실제 백엔드를 호출한다(api/client.ts
# 참고). 기본값은 true(목업)라 이 값을 안 주면 로그인/충전소 목록 등이 전부 가짜 데이터로
# 동작하니, 실제 백엔드로 테스트할 땐 반드시 false로 설정해야 한다.
EXPO_PUBLIC_USE_MOCK=false

# EV-energy-management-backend 주소 (충전소/차량/배터리/충전수요예측 배지 등 공용 API).
# 충전수요예측(charging-demand)은 EKS에 ClusterIP로만 떠 있어 앱이 직접 못 붙기 때문에
# backend의 /api/charging-demand/current를 거쳐서 받는다(api/demand.ts 참고) -
# 별도 EXPO_PUBLIC_DEMAND_API_URL 없이 이 주소 하나면 된다.
EXPO_PUBLIC_API_URL=http://localhost:8080
